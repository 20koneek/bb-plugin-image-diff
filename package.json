{
  "name": "bb-plugin-image-diff",
  "version": "0.1.0",
  "description": "Pixel diff of changed images in BB: Before, Diff and After side by side, with Git LFS images rendered inside the Diff tab.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/20koneek/bb-plugin-image-diff.git"
  },
  "homepage": "https://github.com/20koneek/bb-plugin-image-diff#readme",
  "author": {
    "name": "Pavel Serezhin",
    "url": "https://github.com/20koneek"
  },
  "type": "module",
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.104"
  },
  "bb": {
    "name": "Image Diff",
    "description": "See exactly which pixels changed in an image before you approve it. Before, Diff and After sit side by side, with changed pixels highlighted over a white background, over the new image, or blinking, plus a changed-pixel count. Git LFS images render in place in BB's Diff tab, downloading missing objects on demand. A pinned Image diff tab lists every changed image in the thread, and opening a changed image anywhere shows its diff. LFS images need git-lfs on the host.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [],
    "host": "./host.ts"
  },
  "scripts": {
    "test": "node --test pixel-diff.test.ts lfs.test.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.104",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2"
  }
}
